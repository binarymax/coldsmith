{
  "name": "wintersmith",
  "version": "2.5.0",
  "author": "Johan Nordberg <code@johan-nordberg.com>",
  "description": "A flexible static site generator.",
  "license": "MIT",
  "type": "module",
  "main": "./lib/",
  "keywords": [
    "static",
    "generator",
    "markdown",
    "pug"
  ],
  "bin": {
    "wintersmith": "./bin/wintersmith"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "test:update": "node ./test/update-golden.mjs"
  },
  "directories": {
    "lib": "./lib/"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jnordberg/wintersmith.git"
  },
  "dependencies": {
    "chalk": "^6.0.0",
    "chokidar": "^5.0.0",
    "highlight.js": "^11.12.0",
    "js-yaml": "^5.4.1",
    "marked": "^18.0.11",
    "marked-gfm-heading-id": "^4.1.4",
    "marked-highlight": "^2.2.4",
    "marked-smartypants": "^1.1.12",
    "mime": "^4.1.0",
    "minimatch": "^10.2.6",
    "minimist": "^1.2.0",
    "pug": "^3.0.4",
    "slugg": "^1.2.1"
  },
  "engine": {
    "node": ">=4"
  }
}
