<?xml version="1.0" encoding="utf-8"?>
<% const articles = env.helpers.getArticles(contents) -%>
<rss version="2.0" xmlns:content="http://purl.org/rss/1.0/modules/content/" xmlns:wfw="http://wellformedweb.org/CommentAPI/" xmlns:dc="http://purl.org/dc/elements/1.1/" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title><%= locals.name %></title>
    <atom:link href="<%= locals.url %>/feed.xml" rel="self" type="application/rss+xml"/>
    <link><%= locals.url %></link>
    <description><%= locals.description %></description>
    <pubDate><%= articles[0].rfc822date %></pubDate>
    <generator>Coldsmith - https://github.com/binarymax/coldsmith</generator>
    <language>en</language>
<% articles.forEach(function (article) {
     const permalink = locals.url + article.url
     const author = contents.authors[article.metadata.author + '.json']
-%>
    <item>
      <title><%= article.title %></title>
      <link><%= permalink %></link>
      <pubDate><%= article.rfc822date %></pubDate>
      <guid isPermaLink="true"><%= permalink %></guid>
      <author><%= author ? author.metadata.name : article.author %></author>
<%# passing locals.url resolves all relative urls to absolute -%>
      <description><%= article.getHtml(locals.url) %></description>
    </item>
<% }) -%>
  </channel>
</rss>
