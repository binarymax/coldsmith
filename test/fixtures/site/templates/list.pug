extends layout

block content
  h1 Generated index
  //- Content tree keys, as seen by a plain for-in walk.
  ul.names
    each name in names
      li= name
  //- Content groups. Each registered content plugin and generator contributes
  //- one, and every item lands in exactly one of them.
  ul.groups
    li pages: #{contents._.pages.length}
    li shouts: #{contents._.shouts.length}
    li files: #{contents._.files.length}
    li directories: #{contents._.directories.length}
    li generated: #{contents._.generated.length}
  //- Modules pulled in through the `require` config key.
  p.locals helpers: #{helpers.shout('quiet')}
  p.locals nodePath: #{nodePath.basename('/a/b/c.txt')}
